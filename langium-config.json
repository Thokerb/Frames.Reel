{
    "projectName": "Reel",
    "languages": [{
        "id": "reel",
        "grammar": "src/language/reel.langium",
        "fileExtensions": [".reel"],
        "textMate": {
            "out": "syntaxes/reel.tmLanguage.json"
        },
        "monarch": {
