coupled model Room("room") {
    
    AddModel(BlinkingLightModel, "bl1") {
        state: BlinkingLightState {
            count = 5
            engine.power = 600
            engine.owner = {
                name = "mrbeast"
            }
        }
    }


    BlinkingLightModel "bl2" {
        state: 
    }

    
    AddModel(BlinkingLightModel, "bl2") {
        state: BlinkingLightState {
            count = 10
            engine.power = 800
            engine.owner = {
                name = "elon musk"
            }
        }
    }
    
    Connect bl1.OutPort a to bl2.InPort b
    Connect bl2.OutPort b to bl1.InPort a
}