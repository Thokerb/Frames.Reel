{
    "name": "Reel",
    "description": "Please enter a brief description here",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Thokerb/Frames.Reel"
    },
    "license": "GPL-3.0-only",
    "version": "0.0.1",
    "files": [
        "bin",
        "out",
        "src",
        "syntaxes",
        "LICENSE.md"
    ],
    "type": "module",
    "scripts": {
        "start": "http-server ./dist -p $PORT",
        "build": "tsc -b tsconfig.src.json && node esbuild.mjs",
        "watch": "concurrently -n tsc,esbuild -c blue,yellow \"tsc -b tsconfig.src.json --watch\" \"node esbuild.mjs --watch\"",
        "lint": "eslint src --ext ts",
        "langium:generate": "langium generate",
        "langium:generate:production": "langium generate --mode=production",
        "langium:watch": "langium generate --watch",
        "build:worker": "esbuild --minify ./src/language/main-browser.js --bundle --format=iife --outfile=./public/reel-server-worker.js",
        "esbuild-base": "esbuild ./src/extension/main.ts --bundle --outfile=out/main.js --external:vscode --format=cjs --platform=node",
        "vscode:prepublish": "npm run build && npm run lint",
        "build:web": "npm run build",
        "bundle": "vite build",
        "bundle:serve": "http-server ./dist --port 5175",
        "dev": "vite",
        "dev:debug": "vite --debug --force",
        "serve": "npm run dev",
        "test": "vitest run",
        "generate": "langium generate && npm run build",
        "package": "vsce package"
    },
    "dependencies": {
        "langium": "~3.5.0",
        "vscode-languageclient": "~9.0.1",
        "vscode-languageserver": "~9.0.1",
        "chalk": "~5.3.0",
        "commander": "~11.0.0",
        "@codingame/monaco-vscode-editor-service-override": "~3.2.3",
        "@codingame/monaco-vscode-keybindings-service-override": "~3.2.3",
        "monaco-editor": "npm:@codingame/monaco-vscode-editor-api@~3.2.3",
        "monaco-editor-wrapper": "~4.0.2",
        "monaco-languageclient": "~8.1.1"
    },
    "devDependencies": {
        "@types/node": "^18.0.0",
        "@typescript-eslint/parser": "~7.3.1",
        "@typescript-eslint/eslint-plugin": "~7.3.1",
        "eslint": "~8.57.0",
        "langium-cli": "~3.5.0",
        "typescript": "~5.1.6",
        "@types/vscode": "~1.67.0",
        "concurrently": "~8.2.1",
        "esbuild": "~0.20.2",
        "@codingame/esbuild-import-meta-url-plugin": "~1.0.2",
        "vitest": "~1.4.0",
        "vscode": "npm:@codingame/monaco-vscode-api@~3.2.3",
        "http-server": "~14.1.1",
        "vite": "~5.2.7"
    },
    "volta": {
        "node": "18.19.1",
        "npm": "10.2.4"
    },
    "displayName": "Reel",
    "engines": {
        "vscode": "^1.67.0",
        "node": ">=18.0.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "reel",
                "aliases": [
                    "Reel",
                    "reel"
                ],
                "extensions": [".reel"],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "reel",
                "scopeName": "source.reel",
                "path": "syntaxes/reel.tmLanguage.json"
            }
        ]
    },
    "activationEvents": [
        "onLanguage:reel"
    ],
    "main": "./out/extension/main.cjs",
    "bin": {
        "reel-cli": "./bin/cli.js"
    }
}
